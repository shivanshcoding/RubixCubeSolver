# CubeVision AI — Backend Environment
# Copy this file to .env and fill in your values

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=cubevision

# JWT
JWT_SECRET_KEY=cubevision-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Server
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# LLM Configuration (separate, optional)
# Supports: gemini, openai, local (for GPU-based models)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
LOCAL_LLM_ENDPOINT=http://localhost:11434

# Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads
